root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{yml,yaml,md,json}]
indent_style = space
indent_size = 2

# Recorded command output: byte for byte.
[internal/conn/testdata/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
